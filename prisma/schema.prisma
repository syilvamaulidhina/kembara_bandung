generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PENGELOLA
  WISATAWAN
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum DestinationStatus {
  pending
  aktif
  butuh_perbaikan
  canceled
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role?
  gender    Gender?
  domisili  String?
  photo     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi baru untuk fitur wisatawan
  savedDestinations SavedDestination[]
  itineraries       Itinerary[]
  reviews           Review[]
  visitedPlaces     VisitedPlace[]
}

model Destination {
  id          Int               @id @default(autoincrement())
  name        String
  description String
  address     String
  contact     String?
  latitude    Float
  longitude   Float
  imageUrl    String?
  // Field tambahan dari pengelola (opsional, bisa ditambah nanti)
  openTime    String?           // format "08:00"
  closeTime   String?           // format "17:00"
  ticketPrice Int?              // harga tiket dalam rupiah (bisa null = gratis)
  maxPrice    Int?              // harga maksimal (untuk range harga)
  website     String?
  visitCount  Int               @default(0)
  status      DestinationStatus @default(pending)
  isDeleted   Boolean           @default(false)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  categories        DestinationCategory[]
  savedBy           SavedDestination[]
  itineraryItems    ItineraryItem[]
  reviews           Review[]
  visitedBy         VisitedPlace[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  destinations DestinationCategory[]
  keywords     CategoryKeyword[]
}

model DestinationCategory {
  id            Int @id @default(autoincrement())
  destinationId Int
  categoryId    Int

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([destinationId, categoryId])
}

model CategoryKeyword {
  id         Int      @id @default(autoincrement())
  keyword    String
  categoryId Int
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, keyword])
}

// ============================================================
// TABEL BARU UNTUK FITUR WISATAWAN
// ============================================================

// Destinasi yang disimpan oleh wisatawan
model SavedDestination {
  id            Int      @id @default(autoincrement())
  userId        Int
  destinationId Int
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

// Rencana perjalanan wisatawan
model Itinerary {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String   @default("Rencana Perjalananku")
  totalDistance Float? // dalam km
  estimatedTime Int?   // dalam menit
  estimatedCost Int?   // dalam rupiah
  isAiGenerated Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ItineraryItem[]
}

// Item dalam rencana perjalanan (urutan destinasi)
model ItineraryItem {
  id            Int      @id @default(autoincrement())
  itineraryId   Int
  destinationId Int
  order         Int      // urutan kunjungan (1, 2, 3, ...)
  visitTime     String?  // jam kunjungan yang direkomendasikan "09:00"
  createdAt     DateTime @default(now())

  itinerary   Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, order])
}

// Ulasan wisatawan
model Review {
  id            Int      @id @default(autoincrement())
  userId        Int
  destinationId Int
  rating        Int      // 1–5
  comment       String?
  photoUrl      String?
  helpfulCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId]) // 1 user 1 review per destinasi
}

// Destinasi yang pernah dikunjungi (untuk fitur ulasan + geofencing)
model VisitedPlace {
  id            Int      @id @default(autoincrement())
  userId        Int
  destinationId Int
  visitedAt     DateTime @default(now())
  checkedIn     Boolean  @default(false) // geofencing auto check-in

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}
