generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int                 @id @default(autoincrement())
  name                 String
  email                String              @unique
  password             String
  role                 Role?
  gender               Gender?
  domisili             String?
  photo                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  rejectionReason      String?
  verificationDocument String?
  verificationStatus   VerificationStatus?
  destinations         Destination[]
  events               Event[]
  itineraries          Itinerary[]
  itineraryQueue       ItineraryQueue[]
  reviews              Review[]
  reviewLikes          ReviewLike[]
  savedDestinations    SavedDestination[]
  visitedPlaces        VisitedPlace[]
}

model Destination {
  id              Int                   @id @default(autoincrement())
  name            String
  description     String
  address         String
  contact         String?
  latitude        Float
  longitude       Float
  imageUrl        String?
  openTime        String?
  closeTime       String?
  ticketPrice     Int?
  maxPrice        Int?
  website         String?
  visitCount      Int                   @default(0)
  status          DestinationStatus     @default(pending)
  adminFeedback   String?
  isDeleted       Boolean               @default(false)
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  ownerId         Int?
  addressCity     String?
  addressDistrict String?
  addressProvince String?
  addressStreet   String?
  addressVillage  String?

  // vertex and polygon
  coveragePolygon        Json?
  pendingCoveragePolygon Json?
  coveragePolygonChanged Boolean @default(false)

  aiAnalyses        AiAnalysis[]
  owner             User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  categories        DestinationCategory[]
  views             DestinationView[]
  events            Event[]
  itineraryItems    ItineraryItem[]
  itineraryQueue    ItineraryQueue[]
  reviews           Review[]
  savedBy           SavedDestination[]
  visitedBy         VisitedPlace[]
  coverageHistories DestinationCoverageHistory[]
}

model DestinationCoverageHistory {
  id            Int      @id @default(autoincrement())
  destinationId Int
  polygon       Json
  createdAt     DateTime @default(now())

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Category {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  createdAt    DateTime              @default(now())
  keywords     CategoryKeyword[]
  destinations DestinationCategory[]
}

model DestinationCategory {
  id            Int         @id @default(autoincrement())
  destinationId Int
  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, categoryId])
}

model CategoryKeyword {
  id         Int      @id @default(autoincrement())
  keyword    String
  categoryId Int
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, keyword])
}

model AiAnalysis {
  id            Int         @id @default(autoincrement())
  destinationId Int
  score         Int
  status        String
  message       String
  rawResult     Json
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model SavedDestination {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model ItineraryQueue {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model Itinerary {
  id            Int                @id @default(autoincrement())
  userId        Int
  title         String             @default("Rencana Perjalananku")
  totalDistance Float?
  estimatedTime Int?
  estimatedCost Int?
  isAiGenerated Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?
  startLabel    String?
  startLat      Float?
  startLng      Float?
  startType     StartLocationType?
  startedAt     DateTime?
  status        ItineraryStatus    @default(draft)
  tripDate      DateTime?
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         ItineraryItem[]

  @@index([userId, status])
}

model ItineraryItem {
  id            Int         @id @default(autoincrement())
  itineraryId   Int
  destinationId Int
  order         Int
  visitTime     String?
  createdAt     DateTime    @default(now())
  visited       Boolean     @default(false)
  visitedAt     DateTime?
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  itinerary     Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([itineraryId, order])
}

model Review {
  id            Int          @id @default(autoincrement())
  userId        Int
  destinationId Int
  rating        Int
  comment       String?
  photoUrl      String?
  videoUrl      String?
  helpfulCount  Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         ReviewLike[]

  @@unique([userId, destinationId])
}

model ReviewLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  reviewId  Int
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
}

model VisitedPlace {
  id            Int         @id @default(autoincrement())
  userId        Int
  destinationId Int
  visitedAt     DateTime    @default(now())
  checkedIn     Boolean     @default(false)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
}

model DestinationView {
  id            Int         @id @default(autoincrement())
  destinationId Int
  userId        Int?
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
}

model Event {
  id              Int          @id @default(autoincrement())
  ownerId         Int
  destinationId   Int?
  name            String
  description     String
  bannerUrl       String?
  startDate       DateTime
  endDate         DateTime
  contact         String?
  registrationUrl String?
  status          EventStatus  @default(pending)
  isDeleted       Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  destination     Destination? @relation(fields: [destinationId], references: [id])
  owner           User         @relation(fields: [ownerId], references: [id])
}

enum Role {
  ADMIN
  PENGELOLA
  WISATAWAN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum DestinationStatus {
  pending
  aktif
  butuh_perbaikan
  canceled
}

enum ItineraryStatus {
  draft
  aktif
  selesai
}

enum StartLocationType {
  gps       // GPS user saat membuat itinerary
  bandung   // titik pusat Kota Bandung (default)
  manual    // dipilih manual lewat klik peta
}



enum EventStatus {
  pending
  aktif
  ditolak
  selesai
}
