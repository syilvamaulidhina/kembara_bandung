generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PENGELOLA
  WISATAWAN
}

enum Gender {
  LAKI_LAKI
  PEREMPUAN
}

enum DestinationStatus {
  pending
  aktif
  butuh_perbaikan
  canceled
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String

  role      Role?

  gender    Gender?
  domisili  String?
  photo     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  address     String
  contact     String?
  latitude    Float
  longitude   Float
  imageUrl    String?
  status      DestinationStatus @default(pending)
  isDeleted   Boolean @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories DestinationCategory[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  destinations DestinationCategory[]
}

model DestinationCategory {
  id            Int @id @default(autoincrement())
  destinationId Int
  categoryId    Int

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([destinationId, categoryId])
}